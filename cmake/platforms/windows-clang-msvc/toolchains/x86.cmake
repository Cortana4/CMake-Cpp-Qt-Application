if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
	set(CMAKE_SYSTEM_NAME "Windows")
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
endif()

set(CMAKE_SYSTEM_PROCESSOR "X86")
set(CMAKE_C_COMPILER "clang-cl")
set(CMAKE_CXX_COMPILER "clang-cl")
set(CMAKE_C_COMPILER_TARGET "i686-pc-windows-msvc")
set(CMAKE_CXX_COMPILER_TARGET "i686-pc-windows-msvc")

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
	set(XWIN_ARCH "x86")
	include("${CMAKE_CURRENT_LIST_DIR}/../modules/XWin.cmake")

	set(CMAKE_C_FLAGS_INIT "${XWIN_COMPILER_FLAGS}")
	set(CMAKE_CXX_FLAGS_INIT "${XWIN_COMPILER_FLAGS}")
	set(CMAKE_EXE_LINKER_FLAGS_INIT "${XWIN_LINKER_FLAGS}")
	set(CMAKE_SHARED_LINKER_FLAGS_INIT "${XWIN_LINKER_FLAGS}")
	set(CMAKE_MODULE_LINKER_FLAGS_INIT "${XWIN_LINKER_FLAGS}")
endif()

if(VCPKG_CRT_LINKAGE STREQUAL "dynamic")
	set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
elseif(VCPKG_CRT_LINKAGE STREQUAL "static")
	set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()
